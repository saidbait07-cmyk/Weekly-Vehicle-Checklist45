# SECRET_KEY: Required stable random secret for Flask sessions and CSRF protection.
SECRET_KEY="replace-this-with-a-long-random-secret"

# DATABASE_URL: Defaults to local SQLite (sqlite:///fleet.db).
# For shared production deployment with PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://fleet_user:fleet_password@localhost:5432/fleet_db"
DATABASE_URL="sqlite:///fleet.db"

# APP_TIMEZONE: Timezone used for daily inspection and driver assignment boundaries.
APP_TIMEZONE="Asia/Muscat"

# HTTPS: Set to 1 in production behind TLS to enforce Secure session cookies.
HTTPS="0"

# GEMINI_API_KEY & APP_URL (AI Studio environment variables)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
